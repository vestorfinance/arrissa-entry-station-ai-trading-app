# Copy this to .env and fill in your credentials and discovered endpoints
EXNESS_EMAIL=you@example.com
EXNESS_PASSWORD=yourpassword
# From browser Network tab: the XHR/Fetch endpoint used to log in (e.g. https://api.exness.com/...) 
EXNESS_LOGIN_API=
# Optional: a protected URL to verify login succeeded
EXNESS_VERIFY_URL=https://my.exness.com/webtrading/dashboard
# Optional: override login page used to fetch initial CSRF/cookies
EXNESS_LOGIN_PAGE=https://my.exness.com/accounts/sign-in?lng=en
