# Copy to .env, fill in, then: docker compose up -d
#
# Generate the two keys once and keep them. FERNET_KEY encrypts every broker
# session and provider API key in the database — losing it does not lock you
# out, it makes what is already stored permanently unreadable.
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# What the Caddy INSIDE the stack serves.
# Leave it as :80 unless this stack is holding 80 and 443 itself. It means
# "plain http, no certificate" — right when something in front is doing TLS, and
# right on your own machine. A real hostname here makes it try to fetch a public
# certificate, which cannot work from behind another proxy or from a laptop.
DOMAIN=:80

# WHERE IT ANSWERS.
#
# 8477, on this machine only. It does not take 80 and 443, because those are the
# ports everything else wants and taking them by default means the first `up`
# either fails or takes another site down. 8477 rather than 3000 or 8080 for the
# same reason: those are already spoken for.
#
# Locally that is the whole story — open http://localhost:8477.
#
# On a server, put Caddy (or nginx) in front on 80/443 and point it here:
#   reverse_proxy 127.0.0.1:8477
#
# To let THIS stack own the server and fetch its own certificate instead:
#   HTTP_PORT=80
#   HTTPS_PORT=443
#   DOMAIN=yourdomain.com
HTTP_PORT=127.0.0.1:8477
HTTPS_PORT=127.0.0.1:8443
DB_PASSWORD=
FERNET_KEY=
JWT_SECRET=

# Apple Silicon or any arm64 machine, for local work only:
#   DOCKER_PLATFORM=linux/arm64
# It skips the amd64 emulation and falls back to bundled Chromium instead of
# Edge, which is fine until you need the Exness login to look convincing.
DOCKER_PLATFORM=

# Optional: a residential proxy for the Exness login, if the datacenter IP is
# ever scored down by reCAPTCHA.
EXNESS_PROXY=
