{
  "id": "economic-calendar",
  "name": "Economic Calendar",
  "version": "1.0.5",
  "edition": "free",
  "description": "Scheduled economic releases and what they move, with a live watcher for the minutes around a print.",
  "requires": {
    "core": ">=1.0"
  },
  "provides": {
    "setup": "backend.module:register",
    "guide": "frontend/guide.json",
    "schema": "schema.sql",
    "settings": [
      {
        "key": "calendar_impact",
        "type": "string",
        "default": "high,moderate",
        "label": "Which releases to keep"
      }
    ]
  },
  "backfill": {
    "tables": [
      {
        "table": "calendar_events",
        "since": "event_time"
      }
    ],
    "days": 365
  }
}
